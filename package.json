{
  "name": "smarthrm-mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start:dev": "cross-env NODE_ENV=development npx expo start --dev-client --reset-cache",
    "start:prod": "cross-env NODE_ENV=production npx expo start --dev-client --reset-cache",
    "start:staging": "cross-env NODE_ENV=test npx expo start --dev-client --reset-cache",
    "start:production": "cross-env NODE_ENV=production expo start --dev-client",
    "local:dev:ios": "cross-env NODE_ENV=development npx expo run:ios",
    "local:staging:ios": "cross-env NODE_ENV=test npx expo run:ios --scheme FnBEmpSta",
    "local:prod:ios": "cross-env NODE_ENV=production npx expo run:ios --scheme FnBEmp",
    "local:dev:android": "cross-env NODE_ENV=development npx expo run:android",
    "local:staging:android": "cross-env NODE_ENV=test npx expo run:android",
    "local:prod:android": "cross-env NODE_ENV=production npx expo run:android",
    "distribution:dev:ios": "cross-env NODE_ENV=development npx eas build --profile dev --platform ios --clear-cache",
    "distribution:staging:ios": "cross-env NODE_ENV=test npx eas build --profile staging --platform ios --clear-cache",
    "distribution:prod:ios": "cross-env NODE_ENV=production npx eas build --profile production --platform ios --clear-cache",
    "distribution:dev:android": "cross-env NODE_ENV=development npx eas build --profile dev --platform android --clear-cache",
    "distribution:staging:android": "cross-env NODE_ENV=test npx eas build --profile staging --platform android --clear-cache",
    "distribution:prod:android": "cross-env NODE_ENV=production npx eas build --profile production --platform android --clear-cache",
    "ota:dev": "cross-env NODE_ENV=development eas update --branch dev --clear-cache",
    "ota:staging": "cross-env NODE_ENV=test eas update --branch staging --clear-cache",
    "ota:production": "cross-env NODE_ENV=production eas update --branch production --clear-cache",
    "prebuild:prod:ios": "cross-env NODE_ENV=production expo prebuild --platform ios",
    "prebuild:staging:ios": "cross-env NODE_ENV=test expo prebuild --platform ios",
    "prebuild:staging:android": "cross-env NODE_ENV=test expo prebuild --platform android",
    "prebuild:dev:ios": "cross-env NODE_ENV=development expo prebuild --platform ios",
    "prebuild:dev:android": "cross-env NODE_ENV=development npx expo prebuild --platform android --clean",
    "prebuild:prod:android": "cross-env NODE_ENV=production expo prebuild --platform android",
    "android": "cross-env NODE_ENV=production expo run:android",
    "ios": "cross-env NODE_ENV=production expo run:ios",
    "local:build:prod:android": "cross-env NODE_ENV=production eas build --platform android --local",
    "local:build:staging:android": "cross-env NODE_ENV=test eas build --platform android --local",
    "local:build:dev:android": "cross-env NODE_ENV=development eas build --platform android --local",
    "submit:ios:dev": "cross-env NODE_ENV=development eas submit --platform ios --profile dev",
    "submit:ios:prod": "cross-env NODE_ENV=production eas submit --platform ios --profile production",
    "start": "expo start --dev-client",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "web": "expo start --web"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-aria/dialog": "^0.0.5",
    "@react-native-aria/overlays": "^0.3.15",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/slider": "5.2.1",
    "@react-navigation/native": "^7.1.8",
    "@tanstack/react-query": "^5.101.4",
    "axios": "^1.18.1",
    "expo": "~58.0.23",
    "expo-constants": "~58.0.15",
    "expo-document-picker": "~58.0.4",
    "expo-font": "~58.0.11",
    "expo-haptics": "~58.0.7",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.16",
    "expo-location": "~58.0.20",
    "expo-router": "~58.0.30",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "expo-updates": "~58.0.21",
    "expo-web-browser": "~58.0.7",
    "moment": "^2.30.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "cross-env": "^10.1.0",
    "prettier": "^3.9.6",
    "react-test-renderer": "19.1.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
