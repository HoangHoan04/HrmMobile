# --- PRODUCTION ---
# EXPO_PUBLIC_APP_VARIANT=production
# EXPO_PUBLIC_APP_NAME="HRM Prod"
# EXPO_PUBLIC_BUNDLE_ID=com.hrm.prod
# EXPO_PUBLIC_API="https://api.yourdomain.com/api"

# --- STAGING ---
# EXPO_PUBLIC_APP_VARIANT=staging
# EXPO_PUBLIC_APP_NAME="HRM Staging"
# EXPO_PUBLIC_BUNDLE_ID=com.hrm.staging
# EXPO_PUBLIC_API="https://staging-api.yourdomain.com/api"

# --- DEVELOPMENT ---
# API must be running: dotnet run --project HrmApi/HrmApi.WebApi (port 5036)
# - iOS Simulator on same PC: http://localhost:5036/api/v1 OR LAN IP below
# - Physical iPhone/Android: use LAN IP of dev machine (ipconfig), same Wi-Fi
# - Android Emulator: http://10.0.2.2:5036/api/v1 (auto fallback if EXPO_PUBLIC_API unset)
EXPO_PUBLIC_APP_VARIANT=development
EXPO_PUBLIC_APP_NAME="HRM Dev"
EXPO_PUBLIC_BUNDLE_ID=com.hrm.dev
EXPO_PUBLIC_API="http://192.168.2.98:5036/api/v1"
